# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database Connection (Direct & Pooled for Drizzle)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AI Provider Configuration (OpenRouter - Free Auto-Selected Models)
OPENROUTER_API_KEY=sk-or-v1-your-key
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3.5-lightning:free
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key # usada apenas pelo /api/ocr (Gemini Vision) — opcional

# Open Finance Connector (Adapter with Feature Flag)
PLUGGY_ENABLED=false
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
