{
  "expo": {
    "name": "Equilibrium",
    "slug": "equilibrium-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "equilibrium",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FAF8F4",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.equilibrium.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "O Equilibrium precisa de acesso à câmera para escanear recibos e notas fiscais."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F4"
      },
      "package": "app.equilibrium.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para capturar comprovantes."
        }
      ]
    ]
  }
}
